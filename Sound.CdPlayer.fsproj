<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sound</RootNamespace>
    <AssemblyName>sound</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/Domain.fs" />
    <Compile Include="src/Equalizer.fs" />
    <Compile Include="src/Spectrum.fs" />
    <Compile Include="src/DemoSignal.fs" />
    <Compile Include="src/CdDrive.fs" />
    <Compile Include="src/Ripper.fs" />
    <Compile Include="src/Player.fs" />
    <Compile Include="src/View.fs" />
    <Compile Include="src/App.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Spectre.Console" Version="0.51.1" />
  </ItemGroup>

</Project>
